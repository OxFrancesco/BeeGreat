#!/usr/bin/env bash
# verify-aero wrapper: run the aero CLI inside the isolated environment.
# Usage: scripts/aero <subcommand> [flags]
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
# shellcheck source=env.sh
source "$SCRIPT_DIR/env.sh"

# No git dependency: walk up to the dir holding packages/sugar/package.json,
# the same rule repoRoot() uses in lib.ts.
ROOT="$SCRIPT_DIR"
while [ ! -f "$ROOT/packages/sugar/package.json" ]; do
  if [ "$ROOT" = "/" ]; then
    echo "verify-aero: repo root not found (no packages/sugar/package.json above $SCRIPT_DIR)" >&2
    exit 1
  fi
  ROOT="$(dirname "$ROOT")"
done

cd "$ROOT/packages/sugar"
exec bun "$ROOT/packages/sugar/src/cli.ts" "$@"
