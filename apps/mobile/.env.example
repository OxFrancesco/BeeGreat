# Public runtime configuration. Configure production values in EAS environments.
EXPO_PUBLIC_AGENT_URL=https://your-agent.workers.dev
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# A Sentry DSN is public by design. Keep SENTRY_AUTH_TOKEN private and configure
# it only in EAS build environments for source-map uploads.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
