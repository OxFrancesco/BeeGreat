VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_AGENT_URL=http://localhost:3583

# Browser DSN (public) and server DSN should target the same Sentry project.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Build-only source map credentials. Never expose the auth token as VITE_*.
SENTRY_ORG=
SENTRY_PROJECT=beegreat
SENTRY_AUTH_TOKEN=
