{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pecu-xchat-workerd-test",
  "main": "xchat-workerd-worker.ts",
  "compatibility_date": "2026-08-29",
  "vars": {"POSTHOG_ENABLED":"true"},
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "INFERENCE", "class_name": "UserInference" },{ "name": "STORE", "class_name": "StoreProbe" }, { "name": "MODEL", "class_name": "ModelTransportProbe" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreProbe", "ModelTransportProbe", "UserInference"] }]
}
