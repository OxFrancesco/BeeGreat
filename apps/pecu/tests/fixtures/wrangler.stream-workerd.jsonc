{
  "name": "pecu-stream-workerd-test",
  "main": "stream-workerd-worker.ts",
  "compatibility_date": "2026-08-29",
  "durable_objects": {
    "bindings": [
      {
        "name": "STREAM",
        "class_name": "StreamProbe"
      },
      {
        "name": "DURABLE",
        "class_name": "DurableTurnProbe"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StreamProbe",
        "DurableTurnProbe"
      ]
    }
  ],
  "services": [
    {
      "binding": "RELAY",
      "service": "pecu-stream-workerd-test",
      "entrypoint": "Relay"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
