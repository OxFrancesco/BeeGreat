{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pecu-codex",
  "account_id": "157a8b025a13404b16f11ad7078e53f1",
  "main": "src/cloudflare/codex-worker.ts",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "preview_urls": false,
  "containers": [{ "class_name": "CodexContainer", "image": "containers/codex/Dockerfile", "image_build_context": ".", "instance_type": "lite", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "CODEX", "class_name": "CodexContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CodexContainer"] }]
}
