{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aero-stocks",
  "account_id": "157a8b025a13404b16f11ad7078e53f1",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "aerocli.buddytools.org/aero/stocks*",
      "zone_name": "buddytools.org"
    },
    {
      "pattern": "aerocli.buddytools.org/stocks*",
      "zone_name": "buddytools.org"
    },
    {
      "pattern": "aerocli.buddytools.org/assets/*",
      "zone_name": "buddytools.org"
    }
  ],
  "services": [
    {
      "binding": "AERO",
      "service": "basedbot-aero",
      "remote": true
    },
    {
      "binding": "PECU",
      "service": "basedbot",
      "entrypoint": "StocksGateway",
      "remote": true
    }
  ]
}
