# Pecu is mainnet-only. Use a Crossmint production SERVER key.
CROSSMINT_API_KEY=sk_production_REPLACE_ME

# A stable high-entropy secret used by Crossmint's server signer.
# Never rotate this without a wallet signer migration plan.
CROSSMINT_WALLET_SECRET=

# X Chat keys are restored from Juicebox with this PIN.
# Keep it outside shell history and production logs.
CHAT_PIN=

# Optional. If omitted, Pecu asks xurl for the selected OAuth2 token.
X_ACCESS_TOKEN=
XURL_APP=
XURL_USERNAME=

# Optional explicit bot ID. Otherwise resolved through /2/users/me.
CHAT_BOT_USER_ID=

# Optional comma-separated numeric user IDs to watch explicitly.
CHAT_PEER_USER_IDS=

# Protects Cloudflare-only OpenCode login and manual polling routes.
ADMIN_TOKEN=

# Base mainnet RPC used by the Aerodrome SDK.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/public

# Runtime tuning. Mainnet execution is enabled only when this is exactly true.
ENABLE_MAINNET_EXECUTION=false
POLL_INTERVAL_MS=8000
QUOTE_TTL_SECONDS=120
MAX_SLIPPAGE_BPS=100
DATABASE_PATH=.data/pecu.sqlite

# Optional: Whop API key that enables deposits via /deposit.
WHOP_API_KEY=
# Optional: Whop Standard Webhooks signing secret (ws_...) for POST /whop/webhook.
WHOP_WEBHOOK_SECRET=
# Optional: Whop API base URL; use https://sandbox-api.whop.com/api/v1 for sandbox.
WHOP_API_URL=https://api.whop.com/api/v1
# Optional: Whop API version date sent as the Api-Version-Date header.
WHOP_API_VERSION_DATE=2026-09-13
# Optional: max USD relayed automatically per deposit; larger deposits are held for review.
DEPOSIT_RELAY_MAX_USD=500
# Optional: max USD relayed automatically across all deposits in a 24h window.
DEPOSIT_RELAY_DAILY_MAX_USD=2000

# Optional: Nansen API key that enables /nansen commands and nansen_* tools.
NANSEN_API_KEY=
# Optional: Nansen API base URL.
NANSEN_API_URL=https://api.nansen.ai/api/v1

# Optional TypeSafe routing. Missing key retains the existing Sol path.
TYPESAFE_API_KEY=

# Optional: OpenRouter key for the shared fallback model used when a user has no ChatGPT connection or has hit its usage limit.
OPENROUTER_API_KEY=
POSTHOG_ENABLED=false
