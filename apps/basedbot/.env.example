# BasedBot is mainnet-only. Use a Crossmint production SERVER key.
CROSSMINT_API_KEY=sk_production_REPLACE_ME

# A stable high-entropy secret used by Crossmint's server signer.
# Never rotate this without a wallet signer migration plan.
CROSSMINT_WALLET_SECRET=

# X Chat keys are restored from Juicebox with this PIN.
# Keep it outside shell history and production logs.
CHAT_PIN=

# Optional. If omitted, BasedBot asks xurl for the selected OAuth2 token.
X_ACCESS_TOKEN=
XURL_APP=
XURL_USERNAME=

# Optional explicit bot ID. Otherwise resolved through /2/users/me.
CHAT_BOT_USER_ID=

# Optional comma-separated numeric user IDs to watch explicitly.
CHAT_PEER_USER_IDS=

# Protects Cloudflare-only OpenCode login and manual polling routes.
ADMIN_TOKEN=

# Base mainnet RPC used by the Aerodrome SDK.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/public

# Runtime tuning. Mainnet execution is enabled only when this is exactly true.
ENABLE_MAINNET_EXECUTION=false
POLL_INTERVAL_MS=8000
QUOTE_TTL_SECONDS=120
MAX_SLIPPAGE_BPS=100
DATABASE_PATH=.data/basedbot.sqlite
