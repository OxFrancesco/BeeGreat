---
import PolicyLayout from '../layouts/PolicyLayout.astro'

const sections = [
  { href: '#agreement', label: 'Agreement and eligibility' },
  { href: '#service', label: 'The BeeGreat service' },
  { href: '#subscription', label: 'BeeGreat Pro subscription' },
  { href: '#accounts', label: 'Accounts and security' },
  { href: '#content', label: 'Your content' },
  { href: '#acceptable-use', label: 'Acceptable use' },
  { href: '#ai-health-web3', label: 'AI, health, and Web3' },
  { href: '#third-parties', label: 'Third-party services' },
  { href: '#ownership', label: 'Ownership' },
  { href: '#termination', label: 'Termination and deletion' },
  { href: '#disclaimers', label: 'Disclaimers and liability' },
  { href: '#apple', label: 'Apple-specific terms' },
  { href: '#changes', label: 'Changes and contact' },
