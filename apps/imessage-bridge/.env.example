# Copy to .env. Spectrum Cloud credentials live in your project Settings
# on https://app.photon.codes
PROJECT_ID=
PROJECT_SECRET=

# BeeGreat agent worker (vite dev default port locally)
AGENT_URL=http://localhost:5173
# Must match the BRIDGE_SECRET secret configured on the agent worker
BRIDGE_SECRET=

# Comma-separated `sender=clerkUserId` pairs. Senders not listed here are
# ignored. Example: +15551234567=user_2abcDEF,someone@icloud.com=user_2abcDEF
IMESSAGE_USER_MAP=

# Sentry project dedicated to the bridge process.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
