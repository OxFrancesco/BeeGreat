# Copy to .env. Spectrum Cloud credentials live in your project Settings
# on https://app.photon.codes
PROJECT_ID=
PROJECT_SECRET=

# BeeGreat agent worker (vite dev default port locally)
AGENT_URL=http://localhost:3583
# Must match the BRIDGE_SECRET secret configured on the agent worker
BRIDGE_SECRET=

# Sender identity is resolved dynamically through the agent worker
# (`/bridge/identity`) against Convex `imessageConnections`. Unknown senders
# receive a magic link to sign in or sign up; no static allowlist exists.

# Sentry project dedicated to the bridge process.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
