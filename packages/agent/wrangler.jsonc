{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beegreat-agent",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "CODEX_ADAPTER_URL": "https://codex-adapter.vercel.app/api"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      }
    ]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BEE_SITES_BUCKET",
      "bucket_name": "beegreat-sites"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueRegistry", "FlueBeeAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    },
    // Flue 2.0 upgrade: beta-era persisted stores are reset-only. FlueRegistry
    // is gone from the framework, and beta FlueBeeAgent storage (schema v5) is
    // rejected by the 2.0 runtime, so the class is drained and recreated.
    // Convex keeps the user-visible chat history.
    {
      "tag": "v3",
      "deleted_classes": ["FlueRegistry", "FlueBeeAgent"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["FlueBeeAgent"]
    }
  ]
}
