{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beegreat-agent",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "CODEX_ADAPTER_URL": "https://codex-adapter.vercel.app/api"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      },
      {
        "name": "FLUE_BEE_AGENT",
        "class_name": "FlueBeeAgent"
      },
      {
        "name": "FLUE_REGISTRY",
        "class_name": "FlueRegistry"
      }
    ]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BEE_SITES_BUCKET",
      "bucket_name": "beegreat-sites"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FlueRegistry",
        "FlueBeeAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Sandbox"
      ]
    }
  ],
  "main": ".flue-vite/_entry.ts"
}