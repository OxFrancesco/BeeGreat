# Copy to .dev.vars for local `flue dev`; set as Worker secrets in production.
ELEVENLABS_API_KEY=
# Optional: overrides the default premade voice
ELEVENLABS_VOICE_ID=
# Server-side only. Used to mint short-lived tokens for xAI conversational voice.
XAI_API_KEY=
OPENROUTER_API_KEY=
# Flue-Codex/`bun run dev:chatgpt` injects Pi's short-lived token. Do not save it here.
# OPENAI_CODEX_ACCESS_TOKEN=
CONVEX_URL=
# Optional; derived from CONVEX_URL for *.convex.cloud deployments.
CONVEX_SITE_URL=
# Optional hard paywall: only when set to `true` does the Worker require an
# active BeeGreat Pro subscription for `/agents/*` and `/voice/*` requests.
# Pro stays optional everywhere else.
REQUIRE_SUBSCRIPTION=false
# Devin credentials live only in Convex. This Worker reaches Devin through the
# same authenticated credential broker; no Devin key belongs in this file.
# Private agent-to-Convex credential broker secret. Configure the identical
# value in this Worker and the Convex deployment; never expose it to clients.
AGENT_CREDENTIAL_BROKER_SECRET=
# Clerk Frontend API URL used to verify session tokens
CLERK_JWT_ISSUER_DOMAIN=
# Comma-separated exact browser origins allowed to reach Flue. Production must
# set this to the deployed web app origin; local defaults to http://localhost:3000.
WEB_ALLOWED_ORIGINS=https://your-web-app.example
# Optional: shared secret that lets service bridges (apps/imessage-bridge)
# act on behalf of a user; generate with `openssl rand -hex 32`
BRIDGE_SECRET=

# Verified Flue Beennector ingress. Configure the matching callback in each
# provider dashboard; provider OAuth tokens are stored only in Convex.
GITHUB_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=
NOTION_VERIFICATION_TOKEN=

# Sentry Worker project. Keep the DSN as a Worker secret in production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Use a commit SHA or another immutable deployment identifier.
SENTRY_RELEASE=
