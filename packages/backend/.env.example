# Shared OAuth callback configured in the GitHub, Linear, and Notion apps.
BEENNECTOR_OAUTH_REDIRECT_URI=https://YOUR_DEPLOYMENT.convex.site/beennectors/oauth/callback
# Where the callback sends the browser after OAuth. The mobile scheme also
# works with the web popup because the settings page observes Convex state.
BEENNECTOR_APP_REDIRECT_URI=beegreat://profile
# Generate once with: openssl rand -base64 32
BEENNECTOR_CREDENTIALS_KEY=

GITHUB_BEENNECTOR_CLIENT_ID=
GITHUB_BEENNECTOR_CLIENT_SECRET=
LINEAR_BEENNECTOR_CLIENT_ID=
LINEAR_BEENNECTOR_CLIENT_SECRET=
NOTION_BEENNECTOR_CLIENT_ID=
NOTION_BEENNECTOR_CLIENT_SECRET=

# Must equal the agent Worker value. It authenticates the private Beennector
# broker; never expose it to web or mobile environment variables.
AGENT_CREDENTIAL_BROKER_SECRET=
# Server-side Worker base URL used only for durable Flue conversation cleanup.
AGENT_URL=https://your-agent.workers.dev

# Clerk Dashboard webhook signing secret. Subscribe the endpoint below to
# `user.deleted` so cleanup survives a client crash after identity deletion:
# https://YOUR_DEPLOYMENT.convex.site/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=

# Server-only Clerk key used just-in-time before account deletion to read any
# Apple OAuth access token Clerk holds for that user. Never expose this key in
# an EXPO_PUBLIC_ or web client environment variable.
CLERK_SECRET_KEY=

# Sign in with Apple REST credentials used only when Clerk returns a revocable
# Apple access token. CLIENT_ID must be the exact App ID or Services ID used to
# mint that token. PRIVATE_KEY is the .p8 PEM, either multiline or with escaped
# newlines (-----BEGIN PRIVATE KEY-----\n...).
APPLE_SIGN_IN_CLIENT_ID=com.beegreat.app
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=

# Server-only RevenueCat secret API key from Project settings -> API keys.
# Paid endpoints use it to validate Customer Info directly; never put it in a
# mobile/web public environment variable or bundle it into the app.
REVENUECAT_SECRET_API_KEY=

# Optional fast-path for RevenueCat Pro projects. Without webhooks, the backend
# securely reconciles Customer Info through REVENUECAT_SECRET_API_KEY. If used,
# set the dashboard Authorization header to `Bearer <REVENUECAT_WEBHOOK_SECRET>`
# and point it at:
# https://YOUR_DEPLOYMENT.convex.site/webhooks/revenuecat
REVENUECAT_WEBHOOK_SECRET=
# Required only when the optional webhook is enabled. This is the public
# RevenueCat app identifier (`app...`) from Project settings; webhooks for every
# other app in the project are acknowledged but ignored.
REVENUECAT_APP_ID=

# Devin v3 organization-scoped service user. Use the Member role unless the
# integration needs broader organization administration. Never expose this key
# to web or mobile clients.
DEVIN_API_KEY=cog_your_key_here
DEVIN_ORG_ID=org-your-organization-id

# FAL media generation. FAL_KEY makes the built-in Imagine subagent operational.
# Model overrides are optional; defaults are documented in docs/16-imagine-subagent.md.
FAL_KEY=
FAL_IMAGE_GENERATION_MODEL=
FAL_IMAGE_EDIT_MODEL=
FAL_VIDEO_GENERATION_MODEL=
FAL_VIDEO_EDIT_MODEL=
